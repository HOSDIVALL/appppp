+    private val dispatchCount = java.util.concurrent.atomic.AtomicInteger(0)
+    private val resumeQueued = CountDownLatch(1)
+
+    override fun dispatch(context: kotlin.coroutines.CoroutineContext, block: Runnable) {
+        queue.add(block)
