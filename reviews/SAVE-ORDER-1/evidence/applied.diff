+            temp.outputStream().use { output ->
+                output.write(json)
+                output.fd.sync()
+            }
             if (!temp.renameTo(file)) {
-                file.writeText(json)
-                temp.delete()
+                throw java.io.IOException("Cannot replace notes file")
             }
+        } finally {
+            temp.delete()
         }
         Unit
     }
