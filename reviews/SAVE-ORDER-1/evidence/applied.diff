-    /** 保存全部笔记 */
+    /** Write a unique temporary file; propagate failures without truncating the old file. */
     suspend fun save(notes: List<Note>) = withContext(Dispatchers.IO) {
-        runCatching {
-            val json = notesToJson(notes)
-            // 先写临时文件再改名：写到一半被杀死也不会把原文件写坏
