+package com.example.myapplicationfirstapp.data.txn
+
+import androidx.test.ext.junit.runners.AndroidJUnit4
+import kotlinx.coroutines.runBlocking
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNotNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import org.junit.runner.RunWith
+
+/**
+ * 清理：顺序固定（结果 → 材料 → 目录 → journal → 凭据），关键步骤失败即停。
+ *
+ * 每个中断点都必须满足同一件事：**结论仍是已提交**，不能被重新解释成需要回滚。
+ */
+@RunWith(AndroidJUnit4::class)
+internal class ImportTxnCleanupTest : TxnKernelTestBase() {
+
+    private val oldNotes = """[{"id":"n1","title":"旧"}]"""
+    private val newNotes = """[{"id":"n1","title":"新"}]"""
+    private val oldA = byteArrayOf(1, 1, 1)
+    private val newA = byteArrayOf(2, 2, 2)
+
+    private fun plantCommitted(txnId: String = "t1") {
+        sandbox.plant(
+            PlantedTxn(txnId, oldNotes, newNotes, mapOf("a.jpg" to oldA), mapOf("a.jpg" to newA)),
+            notesState = NotesState.NEW,
+            journalState = JournalState.COMMITTED,
+            writeCredential = true
+        )
+    }
+
+    @Test
+    fun journalDeleteFailureKeepsCredentialAndCommitFact() = runBlocking {
+        plantCommitted()
+        val ops = FaultyOps().apply { failOnce += TxnStep.JOURNAL }
+        val kernel = sandbox.kernel(ops)
+
+        val outcome = kernel.recover()
+        assertTrue(outcome is RecoverOutcome.Settled)
+        assertEquals("journal", (outcome as RecoverOutcome.Settled).cleanup?.stoppedAt)
+        assertEquals(DiskState.Committed("t1"), kernel.inspect())
+        assertTrue("journal 应仍在", sandbox.journalFile().isFile)
+        assertTrue("凭据应仍在", sandbox.credentialFile().isFile)
+        assertFalse("材料应已删完", sandbox.txnDir("t1").exists())
+        sandbox.expectNotes(newNotes, "已提交的笔记不得被回滚")
+
+        val second = kernel.recover()
+        assertTrue((second as RecoverOutcome.Settled).cleanup?.cleaned == true)
+        assertEquals(DiskState.Idle, kernel.inspect())
+    }
+
+    @Test
+    fun credentialDeleteFailureKeepsJournalGoneAndMaterialsGone() = runBlocking {
+        plantCommitted()
+        val ops = FaultyOps().apply { failOnce += TxnStep.CREDENTIAL }
+        val kernel = sandbox.kernel(ops)
+
+        val outcome = kernel.recover()
+        assertEquals("credential", (outcome as RecoverOutcome.Settled).cleanup?.stoppedAt)
+        assertEquals(DiskState.Committed("t1"), kernel.inspect())
+        assertFalse("journal 已删", sandbox.journalFile().exists())
+        assertTrue("凭据仍在", sandbox.credentialFile().isFile)
+        assertFalse(sandbox.txnDir("t1").exists())
+
+        kernel.recover()
+        assertEquals(DiskState.Idle, kernel.inspect())
+    }
+
+    @Test
+    fun materialDeleteFailureStopsBeforeEvidence() = runBlocking {
+        plantCommitted()
+        val ops = FaultyOps().apply { failOnce += "delete-material:old-attachments/a.jpg" }
+        val kernel = sandbox.kernel(ops)
+
+        val outcome = kernel.recover()
+        assertEquals("materials", (outcome as RecoverOutcome.Settled).cleanup?.stoppedAt)
+        assertEquals(DiskState.Committed("t1"), kernel.inspect())
+        assertTrue("journal 必须保留", sandbox.journalFile().isFile)
+        assertTrue("凭据必须保留", sandbox.credentialFile().isFile)
+        assertTrue("材料仍在", sandbox.txnDir("t1").isDirectory)
+
+        kernel.recover()
+        assertEquals(DiskState.Idle, kernel.inspect())
+    }
+
+    @Test
+    fun materialsAreNeverLeftWithoutEvidence() = runBlocking {
+        plantCommitted()
+        val ops = FaultyOps().apply { alwaysFail += "delete-material:old-attachments/a.jpg" }
+        val kernel = sandbox.kernel(ops)
+
+        repeat(3) { kernel.recover() }
+
+        // 材料删不掉时，绝不能把 journal/凭据删掉——否则会退化成无法判定的隔离态
+        assertTrue(sandbox.txnDir("t1").isDirectory)
+        assertTrue(sandbox.journalFile().isFile)
+        assertTrue(sandbox.credentialFile().isFile)
+        assertEquals(DiskState.Committed("t1"), kernel.inspect())
+
+        ops.alwaysFail.clear()
+        kernel.recover()
+        assertEquals(DiskState.Idle, kernel.inspect())
+    }
+
+    @Test
+    fun resultWriteFailureStopsBeforeAnyDeletion() = runBlocking {
+        plantCommitted()
+        val ops = FaultyOps().apply { alwaysFail += TxnStep.RESULTS }
+        val kernel = sandbox.kernel(ops)
+
+        val outcome = kernel.recover()
+        assertEquals("results", (outcome as RecoverOutcome.Settled).cleanup?.stoppedAt)
+        assertEquals(DiskState.Committed("t1"), kernel.inspect())
+        assertTrue("结果没写成就不能开始删", sandbox.txnDir("t1").isDirectory)
+        assertTrue(sandbox.journalFile().isFile)
+        assertTrue(sandbox.credentialFile().isFile)
+
+        ops.alwaysFail.clear()
+        kernel.recover()
+        assertEquals(DiskState.Idle, kernel.inspect())
+        assertNotNull(sandbox.results().firstOrNull { it.txnId == "t1" })
+    }
+
+    @Test
+    fun cleanupRefusesInterruptedStateAndKeepsMaterials() = runBlocking {
+        sandbox.plant(
+            PlantedTxn("t1", oldNotes, newNotes, mapOf("a.jpg" to oldA), mapOf("a.jpg" to newA)),
+            notesState = NotesState.NEW
+        )
+        val kernel = sandbox.kernel()
+
+        val outcome = kernel.cleanup("t1")
+        assertFalse(outcome.cleaned)
+        assertEquals("state", outcome.stoppedAt)
+        assertTrue(sandbox.txnDir("t1").isDirectory)
+        assertTrue(sandbox.journalFile().isFile)
+        assertEquals(DiskState.Interrupted("t1"), kernel.inspect())
+    }
+
+    @Test
+    fun resultsRemainQueryableByTxnIdAfterCleanup() = runBlocking {
+        plantCommitted()
+        val kernel = sandbox.kernel()
+
+        kernel.recover()
+        assertEquals(DiskState.Idle, kernel.inspect())
+        assertTrue("结果留存不得被清理删掉", sandbox.resultsFile().isFile)
+
+        val record = kernel.currentResult("t1")
+        assertNotNull(record)
+        assertEquals(ResultOutcome.COMMITTED, record!!.outcome)
+        assertFalse(record.consumed)
+        assertTrue(kernel.markConsumed("t1"))
+        assertTrue(kernel.currentResult("t1")!!.consumed)
+    }
+
+    @Test
+    fun ordinarySaveAfterCleanupIsNotMistakenForCorruption() = runBlocking {
+        plantCommitted()
+        val kernel = sandbox.kernel()
+        kernel.recover()
+
+        // 用户在导入之后继续编辑并保存：内容与旧事务摘要不同，但这不是损坏
+        sandbox.writeNotes("""[{"id":"n1","title":"导入后再编辑"}]""")
+        assertEquals(DiskState.Idle, kernel.inspect())
+        assertNotNull("历史结果仍应可查", kernel.currentResult("t1"))
+    }
+
+    @Test
+    fun resultsAreCappedAndDeduplicated() = runBlocking {
+        val kernel = sandbox.kernel()
+        sandbox.writeNotes(oldNotes)
+
+        for (index in 1..10) {
+            val txnId = "t$index"
+            val materialized = kernel.materialize(txnId, newNotes.toByteArray(), mapOf("a.jpg" to newA))
+            val digest = (materialized as MaterializeOutcome.Ready).commitDigest
+            val outcome = kernel.commit(MaterialRef(txnId, digest))
+            assertTrue("第 $index 次提交失败：$outcome", outcome is CommitOutcome.Committed)
+        }
+
+        val records = kernel.results()
+        assertEquals("结果留存上限", 8, records.size)
+        assertEquals("最新的在最前", "t10", records.first().txnId)
+
+        val again = kernel.materialize("t1", newNotes.toByteArray(), mapOf("a.jpg" to newA))
+        kernel.commit(MaterialRef("t1", (again as MaterializeOutcome.Ready).commitDigest))
+        val after = kernel.results()
+        assertEquals(8, after.size)
+        assertEquals("同一 txnId 不应重复", 1, after.count { it.txnId == "t1" })
+        assertEquals("t1", after.first().txnId)
+    }
+}
diff --git a/app/src/androidTest/java/com/example/myapplicationfirstapp/data/txn/ImportTxnCommitTest.kt b/app/src/androidTest/java/com/example/myapplicationfirstapp/data/txn/ImportTxnCommitTest.kt
new file mode 100644
index 0000000..6c55d58
--- /dev/null
+++ b/app/src/androidTest/java/com/example/myapplicationfirstapp/data/txn/ImportTxnCommitTest.kt
@@ -0,0 +1,187 @@
+package com.example.myapplicationfirstapp.data.txn
+
+import androidx.test.ext.junit.runners.AndroidJUnit4
+import kotlinx.coroutines.runBlocking
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import org.junit.runner.RunWith
+import java.io.File
+
+/**
+ * 提交路径：材料校验、备份、替换、不可取消段、清理。
+ *
+ * 失败注入一律是 `injected-io-failure:<step>`，用来把「第几步失败」固定下来；
+ * 它证明的是内核在这一点上的处置，不等价于真实磁盘故障。
+ */
+@RunWith(AndroidJUnit4::class)
+internal class ImportTxnCommitTest : TxnKernelTestBase() {
+
+    private val oldNotes = """[{"id":"n1","title":"旧"}]"""
+    private val newNotes = """[{"id":"n1","title":"新"},{"id":"n2","title":"第二"}]"""
+    private val oldAttachment = mapOf("a.jpg" to byteArrayOf(1, 1, 1, 1))
+    private val newAttachment = mapOf("a.jpg" to byteArrayOf(2, 2, 2, 2), "b.jpg" to byteArrayOf(3, 3))
+
+    private suspend fun commit(
+        ops: FaultyOps,
+        txnId: String = "t1",
+        notes: String = newNotes,
+        attachments: Map<String, ByteArray> = newAttachment,
+        expected: String? = null
+    ): CommitOutcome {
+        val kernel = sandbox.kernel(ops)
+        val materialized = kernel.materialize(txnId, notes.toByteArray(), attachments)
+        assertTrue("材料落地失败：$materialized", materialized is MaterializeOutcome.Ready)
+        val digest = (materialized as MaterializeOutcome.Ready).commitDigest
+        return kernel.commit(MaterialRef(txnId, expected ?: digest))
+    }
+
+    private fun seed() {
+        sandbox.writeNotes(oldNotes)
+        oldAttachment.forEach { (name, bytes) -> sandbox.writeAttachment(name, bytes) }
+    }
+
+    @Test
+    fun happyPathCommitsReplacesAttachmentsAndCleansUp() = runBlocking {
+        seed()
+        val ops = FaultyOps()
+        val outcome = commit(ops)
+
+        assertTrue("应已提交，实际=$outcome", outcome is CommitOutcome.Committed)
+        assertEquals(2, (outcome as CommitOutcome.Committed).count)
+        assertTrue(outcome.cleanup.cleaned)
+
+        sandbox.expectNotes(newNotes, "笔记应为新载荷")
+        sandbox.expectAttachments(newAttachment, "附件应为新内容")
+        assertFalse("journal 应已清理", sandbox.journalFile().exists())
+        assertFalse("凭据应已清理", sandbox.credentialFile().exists())
+        assertFalse("事务目录应已清理", sandbox.txnDir("t1").exists())
+        assertTrue("临时文件未清干净：${sandbox.tempFiles()}", sandbox.tempFiles().isEmpty())
+
+        val record = sandbox.results().single()
+        assertEquals(ResultOutcome.COMMITTED, record.outcome)
+        assertEquals("t1", record.txnId)
+        assertEquals(DiskState.Idle, sandbox.kernel().inspect())
+    }
+
+    @Test
+    fun materialChangedIsNotStartedAndTouchesNothing() = runBlocking {
+        seed()
+        val outcome = commit(FaultyOps(), expected = "0".repeat(64))
+
+        assertTrue("应拒绝，实际=$outcome", outcome is CommitOutcome.NotStarted)
+        assertEquals("material-changed", (outcome as CommitOutcome.NotStarted).reason)
+        sandbox.expectNotes(oldNotes, "笔记不得被改动")
+        assertFalse(sandbox.journalFile().exists())
+    }
+
+    @Test
+    fun journalWriteFailureLeavesLiveDataUntouched() = runBlocking {
+        seed()
+        val ops = FaultyOps().apply { failOnce += TxnStep.JOURNAL }
+        val outcome = commit(ops)
+
+        assertTrue(outcome is CommitOutcome.NotStarted)
+        assertEquals("journal-write-failed", (outcome as CommitOutcome.NotStarted).reason)
+        sandbox.expectNotes(oldNotes, "笔记不得被改动")
+        assertTrue("附件不得被改动", sandbox.attachment("a.jpg").readBytes().contentEquals(oldAttachment.getValue("a.jpg")))
+    }
+
+    @Test
+    fun unreadableNotesIsNotStarted() = runBlocking {
+        // 让 notes.json 变成一个目录：存在但读不出来，必须拒绝而不是当成「没有笔记」
+        sandbox.notesFile().mkdirs()
+        val outcome = commit(FaultyOps())
+
+        assertTrue(outcome is CommitOutcome.NotStarted)
+        assertEquals("notes-unreadable", (outcome as CommitOutcome.NotStarted).reason)
+    }
+
+    @Test
+    fun insufficientSpaceIsNotStarted() = runBlocking {
+        seed()
+        val ops = FaultyOps().apply { forcedUsableSpace = 0L }
+        val outcome = commit(ops)
+
+        assertTrue(outcome is CommitOutcome.NotStarted)
+        assertEquals("insufficient-space", (outcome as CommitOutcome.NotStarted).reason)
+        sandbox.expectNotes(oldNotes, "笔记不得被改动")
+    }
+
+    @Test
+    fun unsafeTxnIdIsRejected() = runBlocking {
+        seed()
+        val outcome = sandbox.kernel().commit(MaterialRef("../escape"))
+
+        assertTrue(outcome is CommitOutcome.NotStarted)
+        assertEquals("unsafe-txn-id", (outcome as CommitOutcome.NotStarted).reason)
+    }
+
+    @Test
+    fun identicalNotesDifferentAttachmentsRollsBackAttachmentsOnly() = runBlocking {
+        // 反例：新旧 notes 字节完全相同，只有附件不同。回滚不能因为「notes 已经是新内容」就跳过，
+        // 也不能因为「notes 没变」就以为事务没发生过。
+        sandbox.writeNotes(oldNotes)
+        sandbox.writeAttachment("a.jpg", byteArrayOf(1, 1, 1, 1))
+        val ops = FaultyOps().apply { failOnce += TxnStep.NOTES }
+        val outcome = commit(ops, notes = oldNotes, attachments = mapOf("a.jpg" to byteArrayOf(9, 9), "b.jpg" to byteArrayOf(8)))
+
+        assertTrue("应回滚，实际=$outcome", outcome is CommitOutcome.Failed)
+        sandbox.expectNotes(oldNotes, "新旧 notes 相同，字节必须保持")
+        sandbox.expectAttachments(mapOf("a.jpg" to byteArrayOf(1, 1, 1, 1)), "附件必须回到旧内容，新增附件必须删掉")
+        assertEquals(DiskState.Idle, sandbox.kernel().inspect())
+    }
+
+    @Test
+    fun absentOldNotesIsCreatedWithoutCopy() = runBlocking {
+        val ops = FaultyOps()
+        val outcome = commit(ops, notes = newNotes, attachments = mapOf("a.jpg" to byteArrayOf(7)))
+
+        assertTrue(outcome is CommitOutcome.Committed)
+        sandbox.expectNotes(newNotes, "旧文件不存在时应新建")
+        assertFalse(
+            "旧 notes 不存在时不应产生副本",
+            ops.sawCheckpoint(TxnStep.OLD_NOTES)
+        )
+        assertEquals(DiskState.Idle, sandbox.kernel().inspect())
+    }
+
+    @Test
+    fun activeJournalRefusesSecondCommit() = runBlocking {
+        sandbox.plant(
+            PlantedTxn("t0", oldNotes, newNotes, oldAttachment, newAttachment),
+            notesState = NotesState.OLD
+        )
+        val outcome = commit(FaultyOps(), txnId = "t1")
+
+        assertTrue(outcome is CommitOutcome.NotStarted)
+        assertTrue(
+            "应说明已有事务，实际=${(outcome as CommitOutcome.NotStarted).reason}",
+            outcome.reason.startsWith("journal-present")
+        )
+    }
+
+    @Test
+    fun quarantinedTransactionBlocksNewCommit() = runBlocking {
+        File(sandbox.root, ".import/txn-zombie").mkdirs()
+        val outcome = commit(FaultyOps(), txnId = "t1")
+
+        assertTrue(outcome is CommitOutcome.NotStarted)
+        assertEquals("quarantined:txn-zombie", (outcome as CommitOutcome.NotStarted).reason)
+        assertTrue("隔离目录不得被顺带删掉", File(sandbox.root, ".import/txn-zombie").isDirectory)
+    }
+
+    @Test
+    fun commitRefusesWhenGateIsBlocked() = runBlocking {
+        seed()
+        val gate = WriteGate().apply { enter(WriteGate.Mode.BLOCKED) }
+        val kernel = sandbox.kernel(gate = gate)
+        val materialized = kernel.materialize("t1", newNotes.toByteArray(), newAttachment)
+        val digest = (materialized as MaterializeOutcome.Ready).commitDigest
+
+        val outcome = kernel.commit(MaterialRef("t1", digest))
+        assertTrue("写前应被拒，实际=$outcome", outcome is CommitOutcome.Refused)
+        sandbox.expectNotes(oldNotes, "被拒时不得有任何写入")
+    }
+}
