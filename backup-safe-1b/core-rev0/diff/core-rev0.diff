new file mode 100644
index 0000000..1fbce42
--- /dev/null
+++ b/app/src/main/java/com/example/myapplicationfirstapp/data/txn/TxnFileOps.kt
@@ -0,0 +1,129 @@
+package com.example.myapplicationfirstapp.data.txn
+
+import java.io.File
+import java.io.FileOutputStream
+import java.io.IOException
+import java.security.MessageDigest
+
+/**
+ * 事务内核的文件接缝。
+ *
+ * 内核只认这一层，不直接 `File.writeBytes()`，原因有两个：
+ *
+ * 1. **可注入**：测试要在指定步骤注入 IO 异常或阻塞，才能把「第 3 个附件写完就崩」「凭据写一半」
+ *    这类位置固定下来。生产实现 [RealTxnFileOps] 没有任何「测试模式」分支。
+ * 2. **原子写只有一种写法**：`temp → write → fsync → rename`。把它收敛到一个方法里，
+ *    内核里就不会出现「某处忘了 fsync」这种逐步骤漂移。
+ *
+ * 所有路径都相对于调用方给定的**存储根**（生产是 `filesDir`，测试是隔离沙箱），
+ * 本接口不持有 Context，也不解析任何全局路径。
+ */
+internal interface TxnFileOps {
+
+    fun exists(file: File): Boolean
+
+    fun isDirectory(file: File): Boolean
+
+    /** 目录内条目，按名字排序；目录不存在返回空列表 */
+    fun list(dir: File): List<File>
+
+    /** 读取完整字节；不存在或读失败抛 IOException */
+    fun readBytes(file: File): ByteArray
+
+    /**
+     * 原子写：同目录 `temp` → 写入 → `fsync` → `rename`。
+     *
+     * 失败时抛 IOException，并尽力删除临时文件；不得留下半份正式文件。
+     */
+    fun writeAtomic(file: File, bytes: ByteArray)
+
+    fun rename(from: File, to: File): Boolean
+
+    fun delete(file: File): Boolean
+
+    fun deleteTree(dir: File): Boolean
+
+    fun mkdirs(dir: File): Boolean
+
+    fun digest(file: File): String
+
+    fun digestBytes(bytes: ByteArray): String
+
+    fun length(file: File): Long
+
+    /** 该目录所在存储的可用字节；测试可注入一个很小的值覆盖空间预检 */
+    fun usableSpace(dir: File): Long
+
+    /**
+     * 确定性注入点。内核在**每个会改变磁盘的动作之前**调用一次，名字稳定（见 [TxnStep]）。
+     *
+     * 生产实现是空操作；测试实现可以在这里抛 IOException（模拟注入的 IO 异常）
+     * 或阻塞等待（把取消固定在某个窗口）。这里不做任何「吞异常」处理。
+     */
+    fun checkpoint(name: String) {}
+}
+
+/** 稳定的步骤名。测试用它们定位注入点，不要改成动态字符串。 */
+internal object TxnStep {
+    const val JOURNAL = "journal"
+    const val CREDENTIAL = "credential"
+    const val RESULTS = "results"
+    const val OLD_NOTES = "old-notes"
+    const val OLD_MANIFEST = "old-manifest"
+    const val NOTES = "notes"
+
+    fun oldAttachment(name: String): String = "old-attachment:$name"
+    fun newAttachment(name: String): String = "new-attachment:$name"
+    fun deleteMaterial(relative: String): String = "delete-material:$relative"
+}
+
+internal class RealTxnFileOps : TxnFileOps {
+
+    override fun exists(file: File): Boolean = file.exists()
+
+    override fun isDirectory(file: File): Boolean = file.isDirectory
+
+    override fun list(dir: File): List<File> =
+        dir.listFiles()?.sortedBy { it.name } ?: emptyList()
+
+    override fun readBytes(file: File): ByteArray = file.readBytes()
+
+    override fun writeAtomic(file: File, bytes: ByteArray) {
+        val parent = file.parentFile ?: throw IOException("no parent for ${file.name}")
+        if (!parent.isDirectory && !parent.mkdirs()) {
+            throw IOException("cannot create directory ${parent.name}")
+        }
+        val temp = File.createTempFile(".${file.name}-", ".tmp", parent)
+        try {
+            FileOutputStream(temp).use { output ->
+                output.write(bytes)
+                output.fd.sync()
+            }
+            if (!temp.renameTo(file)) throw IOException("cannot replace ${file.name}")
+        } finally {
+            if (temp.exists()) temp.delete()
+        }
+    }
+
+    override fun rename(from: File, to: File): Boolean = from.renameTo(to)
+
+    override fun delete(file: File): Boolean = file.delete()
+
+    override fun deleteTree(dir: File): Boolean {
+        dir.deleteRecursively()
+        return !dir.exists()
+    }
+
+    override fun mkdirs(dir: File): Boolean = dir.isDirectory || dir.mkdirs()
+
+    override fun digest(file: File): String = digestBytes(file.readBytes())
+
+    override fun digestBytes(bytes: ByteArray): String {
+        val digest = MessageDigest.getInstance("SHA-256")
+        return digest.digest(bytes).joinToString("") { "%02x".format(it) }
+    }
+
+    override fun length(file: File): Long = file.length()
+
+    override fun usableSpace(dir: File): Long = dir.usableSpace
+}
diff --git a/app/src/main/java/com/example/myapplicationfirstapp/data/txn/TxnJson.kt b/app/src/main/java/com/example/myapplicationfirstapp/data/txn/TxnJson.kt
new file mode 100644
index 0000000..0af4240
--- /dev/null
+++ b/app/src/main/java/com/example/myapplicationfirstapp/data/txn/TxnJson.kt
@@ -0,0 +1,136 @@
+package com.example.myapplicationfirstapp.data.txn
+
+import org.json.JSONArray
+import org.json.JSONObject
+
+/**
+ * journal / 凭据 / 结果留存的编码。
+ *
+ * 解码一律**严格**：任何必填字段缺失、类型不对、枚举不认识，整份返回 null（视为不可读）。
+ * 不做「尽量读出一部分」——半读出来的 journal 会让回滚目标变成猜出来的值。
+ */
+internal object TxnCodec {
+
+    private const val VERSION = 1
+
+    fun encodeJournal(journal: Journal): String {
+        val attachments = JSONArray()
+        journal.attachments.forEach { entry ->
+            attachments.put(
+                JSONObject()
+                    .put("name", entry.name)
+                    .put("old", entry.old ?: JSONObject.NULL)
+                    .put("new", entry.new)
+            )
+        }
+        return JSONObject()
+            .put("version", VERSION)
+            .put("state", journal.state.name)
+            .put("txnId", journal.txnId)
+            .put("commitDigest", journal.commitDigest)
+            .put("oldNotesDigest", journal.oldNotesDigest ?: JSONObject.NULL)
+            .put("attachments", attachments)
+            .put("failedAt", journal.failedAt ?: JSONObject.NULL)
+            .toString()
+    }
+
+    fun decodeJournal(text: String): Journal? {
+        val root = parse(text) ?: return null
+        if (long(root, "version") != VERSION.toLong()) return null
+        val state = str(root, "state")?.let { name ->
+            JournalState.entries.firstOrNull { it.name == name }
+        } ?: return null
+        val txnId = str(root, "txnId")?.takeIf { it.isNotBlank() } ?: return null
+        val commitDigest = str(root, "commitDigest")?.takeIf { it.isNotBlank() } ?: return null
+        val oldNotesDigest = optionalString(root, "oldNotesDigest").getOrElse { return null }
+        val attachmentsArray = root.opt("attachments") as? JSONArray ?: return null
+        val attachments = ArrayList<JournalAttachment>(attachmentsArray.length())
+        for (index in 0 until attachmentsArray.length()) {
+            val item = attachmentsArray.opt(index) as? JSONObject ?: return null
+            val name = str(item, "name")?.takeIf { it.isNotBlank() } ?: return null
+            val old = optionalString(item, "old").getOrElse { return null }
+            val new = str(item, "new")?.takeIf { it.isNotBlank() } ?: return null
+            attachments += JournalAttachment(name, old, new)
+        }
+        val failedAt = optionalString(root, "failedAt").getOrElse { return null }
+        if (attachments.map { it.name }.toSet().size != attachments.size) return null
+        return Journal(state, txnId, commitDigest, oldNotesDigest, attachments, failedAt)
+    }
+
+    fun encodeCredential(credential: CommitCredential): String = JSONObject()
+        .put("version", VERSION)
+        .put("txnId", credential.txnId)
+        .put("commitDigest", credential.commitDigest)
+        .put("committedAt", credential.committedAt)
+        .toString()
+
+    fun decodeCredential(text: String): CommitCredential? {
+        val root = parse(text) ?: return null
+        if (long(root, "version") != VERSION.toLong()) return null
+        val txnId = str(root, "txnId")?.takeIf { it.isNotBlank() } ?: return null
+        val commitDigest = str(root, "commitDigest")?.takeIf { it.isNotBlank() } ?: return null
+        val committedAt = long(root, "committedAt") ?: return null
+        return CommitCredential(txnId, commitDigest, committedAt)
+    }
+
+    fun encodeResults(records: List<ResultRecord>): String {
+        val array = JSONArray()
+        records.forEach { record ->
+            array.put(
+                JSONObject()
+                    .put("txnId", record.txnId)
+                    .put("outcome", record.outcome.name)
+                    .put("count", record.count)
+                    .put("at", record.at)
+                    .put("reason", record.reason ?: JSONObject.NULL)
+                    .put("consumed", record.consumed)
+            )
+        }
+        return JSONObject().put("version", VERSION).put("records", array).toString()
+    }
+
+    fun decodeResults(text: String): List<ResultRecord>? {
+        val root = parse(text) ?: return null
+        if (long(root, "version") != VERSION.toLong()) return null
+        val array = root.opt("records") as? JSONArray ?: return null
+        val records = ArrayList<ResultRecord>(array.length())
+        for (index in 0 until array.length()) {
+            val item = array.opt(index) as? JSONObject ?: return null
+            val txnId = str(item, "txnId")?.takeIf { it.isNotBlank() } ?: return null
+            val outcome = str(item, "outcome")?.let { name ->
+                ResultOutcome.entries.firstOrNull { it.name == name }
+            } ?: return null
+            val count = long(item, "count")?.toInt() ?: return null
+            val at = long(item, "at") ?: return null
+            val reason = optionalString(item, "reason").getOrElse { return null }
+            val consumed = bool(item, "consumed") ?: return null
+            records += ResultRecord(txnId, outcome, count, at, reason, consumed)
+        }
+        return records
+    }
+
+    private fun parse(text: String): JSONObject? = try {
+        JSONObject(text)
+    } catch (failure: Exception) {
+        null
+    }
+
+    private fun str(root: JSONObject, key: String): String? = root.opt(key) as? String
+
+    /** 缺省与显式 null 都算成功（值为 null）；类型不对算失败，由调用方整份判不可读 */
+    private fun optionalString(root: JSONObject, key: String): Result<String?> {
+        val value = root.opt(key)
+        return when {
+            value == null || value == JSONObject.NULL -> Result.success(null)
+            value is String -> Result.success(value)
+            else -> Result.failure(IllegalArgumentException(key))
+        }
+    }
+
+    private fun long(root: JSONObject, key: String): Long? = when (val value = root.opt(key)) {
+        is Number -> value.toLong()
+        else -> null
+    }
+
+    private fun bool(root: JSONObject, key: String): Boolean? = root.opt(key) as? Boolean
+}
diff --git a/app/src/main/java/com/example/myapplicationfirstapp/data/txn/TxnModels.kt b/app/src/main/java/com/example/myapplicationfirstapp/data/txn/TxnModels.kt
new file mode 100644
index 0000000..5ed7328
--- /dev/null
+++ b/app/src/main/java/com/example/myapplicationfirstapp/data/txn/TxnModels.kt
@@ -0,0 +1,150 @@
+package com.example.myapplicationfirstapp.data.txn
+
+/**
+ * 事务内核的数据模型。
+ *
+ * 这里刻意不引用 `Note` / `PreparedBackup`：内核只处理**已物化的字节**
+ * （`commit.json`、附件内容、旧数据），物化（补 ID/时间戳、生成 `plan.json`）
+ * 属于 prepare 接线，是后批的事。这样内核可以在任意隔离根上被测试，
+ * 也不会因为改 `Note` 而连带改事务。
+ */
+
+internal enum class JournalState {
+    PREPARED,
+    APPLYING,
+    ROLLING_BACK,
+    ABORTED,
+    COMMITTED
+}
+
+/**
+ * 一个附件在事务前后的摘要。
+ *
+ * [old] 为 null 表示「提交前没有这个文件」（本次新增）。回滚遇到 `new` 且 `old == null`
+ * 就是删掉它，而不是从副本恢复。
+ */
+internal data class JournalAttachment(
+    val name: String,
+    val old: String?,
+    val new: String
+)
+
+/**
+ * 事务日志。
+ *
+ * 它是**状态机的唯一输入**：回滚目标、逐文件摘要、失败位置都在这里。
+ * 字段类型都是严格解析的，任何一项类型不对都按「不可读」处理（[JournalCodec.decode] 返回 null），
+ * 不做「尽量读出来」的容错——半读出来的 journal 比读不出来更危险。
+ */
+internal data class Journal(
+    val state: JournalState,
+    val txnId: String,
+    val commitDigest: String,
+    val oldNotesDigest: String?,
+    val attachments: List<JournalAttachment>,
+    val failedAt: String? = null
+)
+
+internal data class CommitCredential(
+    val txnId: String,
+    val commitDigest: String,
+    val committedAt: Long
+)
+
+internal enum class ResultOutcome { COMMITTED, ABORTED, NOT_STARTED }
+
+/**
+ * 终态结果记录。按 `txnId` 留存，**不是凭据**，不含摘要，不参与 `classify()`。
+ *
+ * 它只回答「这次导入最后怎么样」，所以清理之后仍可查；也因为它不带摘要，
+ * 后续正常保存把 `notes.json` 改掉，不会被误判成损坏。
+ */
+internal data class ResultRecord(
+    val txnId: String,
+    val outcome: ResultOutcome,
+    val count: Int,
+    val at: Long,
+    val reason: String? = null,
+    val consumed: Boolean = false
+)
+
+/**
+ * 磁盘判定结论。`classify()` 只输出这些值，不做任何写动作。
+ */
+internal sealed interface DiskState {
+
+    data object Idle : DiskState
+
+    /** 材料齐、未动正式数据，等待确认 */
+    data class Prepared(val txnId: String) : DiskState
+
+    /** journal 是 APPLYING 但没有终态证据：必须回滚（不看 notes 是否已等于新载荷） */
+    data class Interrupted(val txnId: String) : DiskState
+
+    data class RollingBack(val txnId: String) : DiskState
+
+    /** 回滚已完成，等待清理 */
+    data class Aborted(val txnId: String) : DiskState
+
+    data class Committed(val txnId: String) : DiskState
+
+    /** PREPARED 但材料不完整：可安全放弃 */
+    data class StagingFailed(val txnId: String) : DiskState
+
+    /**
+     * 有事务材料、却没有 journal 也没有凭据：生命周期无法确定。
+     *
+     * 不删、不回滚，等显式处置。**不**用 `notes.json` 摘要来推断「可以删」。
+     */
+    data class Quarantined(val txnDirs: List<String>) : DiskState
+
+    data class Corrupt(val reason: String) : DiskState
+
+    data class RollbackFailed(val txnId: String, val detail: String) : DiskState
+}
+
+/** 调用方给出的「已物化材料」引用；内核只按这个去磁盘上读，不接受内存里的载荷 */
+internal data class MaterialRef(
+    val txnId: String,
+    /** 调用方期望的载荷摘要；非 null 时与磁盘重算值不符即 `MaterialChanged` */
+    val expectedCommitDigest: String? = null
+)
+
+internal sealed interface MaterializeOutcome {
+    data class Ready(val txnId: String, val commitDigest: String) : MaterializeOutcome
+    data class Rejected(val reason: String) : MaterializeOutcome
+}
+
+internal sealed interface CommitOutcome {
+    /** 已提交；[cleanup] 可能只完成一部分，不影响提交事实 */
+    data class Committed(val count: Int, val cleanup: CleanupOutcome) : CommitOutcome
+
+    /** 尚未动正式数据就退出 */
+    data class NotStarted(val reason: String) : CommitOutcome
+
+    /** 写前被拒（非 OPEN / 已有写入），没有任何 IO 发生 */
+    data class Refused(val refusal: WriteGate.Refusal) : CommitOutcome
+
+    /** 已回滚或停在可判定状态；[detail] 是原始异常信息，用于日志，不用于判定 */
+    data class Failed(val state: DiskState, val detail: String) : CommitOutcome
+}
+
+internal data class CleanupOutcome(
+    val cleaned: Boolean,
+    val leftovers: List<String>,
+    /** 非 null 表示在哪个步骤停下（关键步骤失败或门禁未通过） */
+    val stoppedAt: String? = null
+)
+
+internal sealed interface RollbackOutcome {
+    data object Restored : RollbackOutcome
+    data class Failed(val detail: String) : RollbackOutcome
+}
+
+internal sealed interface RecoverOutcome {
+    /** 收敛到终态（多为 [DiskState.Idle]）；[cleanup] 为本次清理结果 */
+    data class Settled(val state: DiskState, val cleanup: CleanupOutcome?) : RecoverOutcome
+
+    /** 保持现状并停写，交给上层展示或人工处理 */
+    data class Stopped(val state: DiskState, val reason: String) : RecoverOutcome
+}
diff --git a/app/src/main/java/com/example/myapplicationfirstapp/data/txn/WriteGate.kt b/app/src/main/java/com/example/myapplicationfirstapp/data/txn/WriteGate.kt
new file mode 100644
index 0000000..ad9d5ee
--- /dev/null
+++ b/app/src/main/java/com/example/myapplicationfirstapp/data/txn/WriteGate.kt
@@ -0,0 +1,144 @@
+package com.example.myapplicationfirstapp.data.txn
+
+import kotlinx.coroutines.sync.Mutex
+
+/**
+ * 写入资格：`epoch` + `sequence` + `writer` 锁内校验。
+ *
+ * 为什么三样都要：
+ *
+ * - 只有 `epoch`：同代次里「排队很久的旧保存」在导入结束后会被当成新写入。
+ * - 只有 `sequence`：跨代次的回调无法区分（旧代次的 sequence 可能比新代次的大）。
+ * - 没有锁内校验：`beginWrite()` 通过后到真正写盘之间，状态可能已经被改掉。
+ *
+ * ## 两个失败点必须分开
+ *
+ * - [Refusal] / [Admission.Refused]：**写之前**就拒绝（非 OPEN 或已有写入），没有任何 IO。
+ *   调用方应当把它当「这次没写」，不要显示成「保存失败」。
+ * - [Freshness.Stale]：写入可能已经发生，但 ticket 属于旧代次，结果必须**丢弃**。
+ *   把它当失败上报，会把一次正常的新保存标成错误。
+ *
+ * 本类不碰磁盘，也不认识导入；它只回答「现在能不能写、这张 ticket 还算不算数」。
+ */
+internal class WriteGate {
+
+    internal enum class Mode { OPEN, IMPORTING, COMMITTED_PENDING_PUBLISH, BLOCKED, RECOVERING }
+
+    internal data class Ticket(val epoch: Long, val sequence: Long)
+
+    internal enum class Refusal { NotOpen, Busy }
+
+    internal enum class Freshness { Current, Stale }
+
+    internal sealed interface Admission {
+        data class Granted(val ticket: Ticket) : Admission
+        data class Refused(val refusal: Refusal) : Admission
+    }
+
+    internal sealed interface WriteRun<out T> {
+        data class Completed<T>(val value: T) : WriteRun<T>
+        data class Refused(val refusal: Refusal) : WriteRun<Nothing>
+    }
+
+    private val guard = Any()
+    private val writer = Mutex()
+
+    private var mode = Mode.OPEN
+    private var epoch = 0L
+    private var sequence = 0L
+    private var savedSequence = 0L
+    private var holding = false
+
+    fun mode(): Mode = synchronized(guard) { mode }
+
+    fun epoch(): Long = synchronized(guard) { epoch }
+
+    /**
+     * 领一张写票。锁内判定，不排队：非 OPEN 或已有写入 → [Admission.Refused]。
+     *
+     * 这里**不阻塞**等待，是为了让 UI 立刻知道「这次没写」，而不是挂在一个看不见的队列上。
+     */
+    fun beginWrite(): Admission = synchronized(guard) { admitLocked() }
+
+    /**
+     * 持票写入。[block] 在 `writer` 锁内执行，进入前再次核对 `epoch` / `sequence`。
+     *
+     * 返回 [WriteRun.Refused] 时 [block] **没有执行**。
+     */
+    suspend fun <T> write(ticket: Ticket, block: suspend () -> T): WriteRun<T> {
+        if (!writer.tryLock()) return WriteRun.Refused(Refusal.Busy)
+        try {
+            val allowed = synchronized(guard) {
+                mode == Mode.OPEN && !holding &&
+                    ticket.epoch == epoch && ticket.sequence > savedSequence
+            }
+            if (!allowed) return WriteRun.Refused(Refusal.Busy)
+            synchronized(guard) { holding = true }
+            try {
+                val value = block()
+                synchronized(guard) { savedSequence = ticket.sequence }
+                return WriteRun.Completed(value)
+            } finally {
+                synchronized(guard) { holding = false }
+            }
+        } finally {
+            writer.unlock()
+        }
+    }
+
+    /** 回调、结果投递、提醒重排都用它判断「这张票还作不作数」 */
+    fun freshness(ticket: Ticket): Freshness = synchronized(guard) {
+        if (ticket.epoch != epoch || ticket.sequence <= savedSequence) Freshness.Stale else Freshness.Current
+    }
+
+    /**
+     * 事务独占：拿到 writer 锁并领票，直到 [endExclusive] 才释放。
+     *
+     * 整个导入期间 `mode` 由调用方置为 [Mode.IMPORTING]，其他写入一律 `NotOpen`。
+     */
+    suspend fun beginExclusive(): Admission {
+        writer.lock()
+        val admission = synchronized(guard) {
+            val admitted = admitLocked()
+            if (admitted is Admission.Granted) {
+                // 独占就是导入态：写权限在拿到锁的同一刻关闭，不额外自增 epoch
+                mode = Mode.IMPORTING
+                holding = true
+            }
+            admitted
+        }
+        if (admission is Admission.Refused) writer.unlock()
+        return admission
+    }
+
+    /** 结束独占：回到 `OPEN` 并让 `epoch` 自增，使排队中的保存与在途回调一起失效 */
+    fun endExclusive(ticket: Ticket) {
+        synchronized(guard) {
+            savedSequence = maxOf(savedSequence, ticket.sequence)
+            mode = Mode.OPEN
+            epoch++
+            holding = false
+        }
+        writer.unlock()
+    }
+
+    /**
+     * 切换状态。只有影响写权限的切换才自增 `epoch`，其余保持原样，
+     * 免得每次状态刷新都让在途回调变成 `Stale`。
+     */
+    fun enter(next: Mode) {
+        synchronized(guard) {
+            if (next == mode) return
+            val before = mode == Mode.OPEN
+            mode = next
+            if (before || next == Mode.OPEN) epoch++
+        }
+    }
+
+    /** 调用方必须已经持 `guard` */
+    private fun admitLocked(): Admission {
+        if (mode != Mode.OPEN) return Admission.Refused(Refusal.NotOpen)
+        if (holding) return Admission.Refused(Refusal.Busy)
+        return Admission.Granted(Ticket(epoch, ++sequence))
+    }
+}
