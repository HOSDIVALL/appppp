+package com.example.myapplicationfirstapp.data.txn
+
+import androidx.test.ext.junit.runners.AndroidJUnit4
+import kotlinx.coroutines.runBlocking
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNotNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import org.junit.runner.RunWith
+
+/**
+ * core-rev1 回归（B2）：`cleanup(txnId)` 必须先把**参数**与**终态 txnId** 对上。
+ *
+ * 传错 ID 时不得写结果、不得删材料、更不得删全局证据（journal / 凭据）——
+ * 否则一次参数错误就会把另一个事务的提交事实抹掉。
+ */
+@RunWith(AndroidJUnit4::class)
+internal class ImportTxnRev1CleanupIdTest : TxnKernelTestBase() {
+
+    private val oldNotes = """[{"id":"n1","title":"旧"}]"""
+    private val newNotes = """[{"id":"n1","title":"新"}]"""
+    private val oldA = byteArrayOf(1, 1, 1, 1)
+    private val newA = byteArrayOf(2, 2, 2, 2)
+
+    private fun plantCommitted(txnId: String = "t1") {
+        sandbox.plant(
+            PlantedTxn(txnId, oldNotes, newNotes, mapOf("a.jpg" to oldA), mapOf("a.jpg" to newA)),
+            notesState = NotesState.NEW,
+            journalState = JournalState.COMMITTED,
+            writeCredential = true
+        )
+    }
+
+    @Test
+    fun cleanupWithWrongTxnIdTouchesNothing() = runBlocking {
+        plantCommitted()
+        val kernel = sandbox.kernel()
+
+        val outcome = kernel.cleanup("t9")
+        assertFalse("参数与终态 txnId 不符时不得清理，实际=$outcome", outcome.cleaned)
+        assertEquals("txn-id", outcome.stoppedAt)
+        assertTrue("材料必须保留", sandbox.txnDir("t1").isDirectory)
+        assertTrue("journal 必须保留", sandbox.journalFile().isFile)
+        assertTrue("凭据必须保留", sandbox.credentialFile().isFile)
+        assertTrue("不得为错误 txnId 写结果：${sandbox.results()}", sandbox.results().isEmpty())
+        assertEquals(DiskState.Committed("t1"), kernel.inspect())
+        sandbox.expectNotes(newNotes, "不得改动正式数据")
+    }
+
+    @Test
+    fun wrongTxnIdDoesNotConsumeTheRealCleanup() = runBlocking {
+        plantCommitted()
+        val kernel = sandbox.kernel()
+        kernel.cleanup("t9")
+
+        val outcome = kernel.cleanup("t1")
+        assertTrue("正确 txnId 仍应能清理，实际=$outcome", outcome.cleaned)
+        assertEquals(DiskState.Idle, kernel.inspect())
+        assertNotNull("结果必须在正确 txnId 下留存", kernel.currentResult("t1"))
+        assertEquals("错误 txnId 不得留下记录", null, kernel.currentResult("t9"))
+    }
+
+    @Test
+    fun cleanupAfterAbortedAlsoChecksTxnId() = runBlocking {
+        sandbox.plant(
+            PlantedTxn("t1", oldNotes, newNotes, mapOf("a.jpg" to oldA), mapOf("a.jpg" to newA)),
+            notesState = NotesState.OLD,
+            journalState = JournalState.ABORTED
+        )
+        val kernel = sandbox.kernel()
+
+        val wrong = kernel.cleanup("t2")
+        assertFalse("回滚终态同样要核对 txnId", wrong.cleaned)
+        assertEquals("txn-id", wrong.stoppedAt)
+        assertTrue(sandbox.txnDir("t1").isDirectory)
+        assertTrue(sandbox.journalFile().isFile)
+    }
+}
diff -ruN a/app/src/androidTest/java/com/example/myapplicationfirstapp/data/txn/ImportTxnRev1CodecTest.kt b/app/src/androidTest/java/com/example/myapplicationfirstapp/data/txn/ImportTxnRev1CodecTest.kt
--- a/app/src/androidTest/java/com/example/myapplicationfirstapp/data/txn/ImportTxnRev1CodecTest.kt	1970-01-01 08:00:00.000000000 +0800
+++ b/app/src/androidTest/java/com/example/myapplicationfirstapp/data/txn/ImportTxnRev1CodecTest.kt	2026-11-12 02:49:37.102485200 +0800
@@ -0,0 +1,133 @@
+package com.example.myapplicationfirstapp.data.txn
+
+import androidx.test.ext.junit.runners.AndroidJUnit4
+import kotlinx.coroutines.runBlocking
+import org.junit.Assert.assertNotNull
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import org.junit.runner.RunWith
+
+/**
+ * core-rev1 回归（B4）：journal / 凭据的严格校验。
+ *
+ * 三条线：
+ * 1. `oldNotesDigest` 与附件 `old` **必须存在**（允许显式 `null`），缺字段不等于 `null`；
+ * 2. `txnId`、附件名、摘要必须是能落回路径与比较的形状（越界名、非十六进制摘要一律不可读）；
+ * 3. 凭据不可读 ≠ 凭据不存在——这时不能猜「没提交过」去回滚。
+ */
+@RunWith(AndroidJUnit4::class)
+internal class ImportTxnRev1CodecTest : TxnKernelTestBase() {
+
+    private val oldNotes = """[{"id":"n1","title":"旧"}]"""
+    private val newNotes = """[{"id":"n1","title":"新"}]"""
+    private val a = "a1".repeat(32)
+    private val b = "b2".repeat(32)
+
+    private fun journalJson(
+        txnId: String = "t1",
+        commitDigest: String = a,
+        oldNotesField: String = "\"oldNotesDigest\":null,",
+        attachments: String = "[]"
+    ): String = """{"version":1,"state":"APPLYING","txnId":"$txnId","commitDigest":"$commitDigest",""" +
+        oldNotesField + """"attachments":$attachments,"failedAt":null}"""
+
+    @Test
+    fun wellFormedJournalStillDecodes() {
+        assertNotNull(TxnCodec.decodeJournal(journalJson()))
+        assertNotNull(
+            TxnCodec.decodeJournal(
+                journalJson(
+                    oldNotesField = "\"oldNotesDigest\":\"$b\",",
+                    attachments = """[{"name":"a.jpg","old":"$b","new":"$a"}]"""
+                )
+            )
+        )
+    }
+
+    @Test
+    fun journalWithoutOldNotesDigestIsUnreadable() {
+        assertNull(
+            "缺 oldNotesDigest 不得当成「旧文件不存在」",
+            TxnCodec.decodeJournal(journalJson(oldNotesField = ""))
+        )
+    }
+
+    @Test
+    fun attachmentWithoutOldFieldIsUnreadable() {
+        assertNull(
+            "附件缺 old 不得当成新增",
+            TxnCodec.decodeJournal(journalJson(attachments = """[{"name":"a.jpg","new":"$a"}]"""))
+        )
+    }
+
+    @Test
+    fun attachmentWithoutNewFieldIsUnreadable() {
+        assertNull(TxnCodec.decodeJournal(journalJson(attachments = """[{"name":"a.jpg","old":null}]""")))
+    }
+
+    @Test
+    fun journalWithTraversalTxnIdIsUnreadable() {
+        assertNull("txnId 不得越出事务根", TxnCodec.decodeJournal(journalJson(txnId = "../escape")))
+    }
+
+    @Test
+    fun journalWithTraversalAttachmentNameIsUnreadable() {
+        assertNull(
+            "附件名不得越出附件目录",
+            TxnCodec.decodeJournal(
+                journalJson(attachments = """[{"name":"../a.jpg","old":null,"new":"$a"}]""")
+            )
+        )
+    }
+
+    @Test
+    fun journalWithMalformedDigestIsUnreadable() {
+        assertNull("摘要必须是 64 位十六进制", TxnCodec.decodeJournal(journalJson(commitDigest = "abc")))
+    }
+
+    @Test
+    fun credentialWithTraversalTxnIdIsUnreadable() {
+        val text = """{"version":1,"txnId":"../escape","commitDigest":"$a","committedAt":1}"""
+        assertNull(TxnCodec.decodeCredential(text))
+    }
+
+    @Test
+    fun credentialWithMalformedDigestIsUnreadable() {
+        val text = """{"version":1,"txnId":"t1","commitDigest":"xyz","committedAt":1}"""
+        assertNull(TxnCodec.decodeCredential(text))
+    }
+
+    // ---------------- 内核层面 ----------------
+
+    @Test
+    fun unreadableCredentialIsNotTreatedAsAbsent() = runBlocking {
+        sandbox.plant(
+            PlantedTxn("t1", oldNotes, newNotes, emptyMap(), mapOf("a.jpg" to byteArrayOf(2, 2))),
+            notesState = NotesState.NEW
+        )
+        sandbox.credentialFile().writeText("{torn")
+
+        val kernel = sandbox.kernel()
+        val state = kernel.inspect()
+        assertTrue("凭据不可读不得退化成「没凭据 → 回滚」，实际=$state", state is DiskState.Corrupt)
+
+        val outcome = kernel.rollback("t1")
+        assertTrue("凭据不可读时不得猜测回滚，实际=$outcome", outcome is RollbackOutcome.Failed)
+        sandbox.expectNotes(newNotes, "不得改动正式数据")
+    }
+
+    @Test
+    fun journalWithUnsafeTxnIdNeverReachesDisk() = runBlocking {
+        sandbox.plant(
+            PlantedTxn("t1", oldNotes, newNotes, emptyMap(), mapOf("a.jpg" to byteArrayOf(2, 2))),
+            notesState = NotesState.NEW
+        )
+        sandbox.writeJournalRaw(journalJson(txnId = "../escape"))
+
+        val kernel = sandbox.kernel()
+        assertTrue("越界 txnId 的 journal 必须不可读", kernel.inspect() is DiskState.Corrupt)
+        assertTrue(kernel.rollback("t1") is RollbackOutcome.Failed)
+        sandbox.expectNotes(newNotes, "不得按越界路径写盘")
+    }
+}
diff -ruN a/app/src/androidTest/java/com/example/myapplicationfirstapp/data/txn/ImportTxnRev1GateTest.kt b/app/src/androidTest/java/com/example/myapplicationfirstapp/data/txn/ImportTxnRev1GateTest.kt
--- a/app/src/androidTest/java/com/example/myapplicationfirstapp/data/txn/ImportTxnRev1GateTest.kt	1970-01-01 08:00:00.000000000 +0800
+++ b/app/src/androidTest/java/com/example/myapplicationfirstapp/data/txn/ImportTxnRev1GateTest.kt	2026-11-12 02:49:37.116882500 +0800
@@ -0,0 +1,173 @@
+package com.example.myapplicationfirstapp.data.txn
+
+import androidx.test.ext.junit.runners.AndroidJUnit4
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.runBlocking
+import kotlinx.coroutines.withTimeoutOrNull
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNotNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import org.junit.runner.RunWith
+import java.util.concurrent.CountDownLatch
+import java.util.concurrent.TimeUnit
+
+/**
+ * core-rev1 回归（B3）：闸门释放与 `OPEN` 是两件事。
+ *
+ * - 磁盘没收敛到 `Idle`（`Corrupt` / `Quarantined` / `RollbackFailed` / 清理未完成）时，普通保存继续停写；
+ * - 恢复与普通写共享同一把写锁，恢复要等正在跑的保存退出；
+ * - 写票带闸门身份，跨闸门不得通过；重放被拒的原因是「票已失效」而不是「写正忙」。
+ */
+@RunWith(AndroidJUnit4::class)
+internal class ImportTxnRev1GateTest : TxnKernelTestBase() {
+
+    private val oldNotes = """[{"id":"n1","title":"旧"}]"""
+    private val newNotes = """[{"id":"n1","title":"新"}]"""
+    private val oldA = byteArrayOf(1, 1, 1, 1)
+    private val newA = byteArrayOf(2, 2, 2, 2)
+    private val newB = byteArrayOf(3, 3)
+
+    private fun spec() = PlantedTxn(
+        txnId = "t1",
+        oldNotes = oldNotes,
+        newNotes = newNotes,
+        oldAttachments = mapOf("a.jpg" to oldA),
+        newAttachments = mapOf("a.jpg" to newA, "b.jpg" to newB)
+    )
+
+    private suspend fun seed() {
+        sandbox.writeNotes(oldNotes)
+        sandbox.writeAttachment("a.jpg", oldA)
+    }
+
+    // ---------------- 停写与放行 ----------------
+
+    @Test
+    fun recoverAfterCorruptKeepsWritesBlocked() = runBlocking {
+        sandbox.writeJournalRaw("{not-json")
+        val gate = WriteGate()
+        val kernel = sandbox.kernel(gate = gate)
+
+        val outcome = kernel.recover()
+        assertTrue("损坏态必须停手，实际=$outcome", outcome is RecoverOutcome.Stopped)
+        assertTrue("损坏态不得放行普通保存", gate.beginWrite() is WriteGate.Admission.Refused)
+    }
+
+    @Test
+    fun recoverAfterQuarantineKeepsWritesBlocked() = runBlocking {
+        sandbox.plant(spec(), notesState = NotesState.NEW, writeJournal = false)
+        val gate = WriteGate()
+        val kernel = sandbox.kernel(gate = gate)
+
+        val outcome = kernel.recover()
+        assertTrue(outcome is RecoverOutcome.Stopped)
+        assertTrue("隔离态不得放行普通保存", gate.beginWrite() is WriteGate.Admission.Refused)
+    }
+
+    @Test
+    fun recoverAfterRollbackFailedKeepsWritesBlocked() = runBlocking {
+        sandbox.plant(spec(), notesState = NotesState.NEW)
+        val ops = FaultyOps().apply { failOnce += "old-attachment:a.jpg" }
+        val gate = WriteGate()
+        val kernel = sandbox.kernel(ops, gate)
+
+        val outcome = kernel.recover()
+        assertTrue("应停在回滚失败，实际=$outcome", outcome is RecoverOutcome.Stopped)
+        assertTrue("回滚失败不得放行普通保存", gate.beginWrite() is WriteGate.Admission.Refused)
+    }
+
+    @Test
+    fun commitWithUnfinishedCleanupKeepsWritesBlocked() = runBlocking {
+        seed()
+        val ops = FaultyOps().apply { failOnce += "delete-material:old-attachments/a.jpg" }
+        val gate = WriteGate()
+        val kernel = sandbox.kernel(ops, gate)
+        val materialized = kernel.materialize("t1", newNotes.toByteArray(), mapOf("a.jpg" to newA, "b.jpg" to newB))
+        val digest = (materialized as MaterializeOutcome.Ready).commitDigest
+
+        val outcome = kernel.commit(MaterialRef("t1", digest))
+        assertTrue("应已提交，实际=$outcome", outcome is CommitOutcome.Committed)
+        assertEquals("materials", (outcome as CommitOutcome.Committed).cleanup.stoppedAt)
+        assertTrue("清理没做完就不能放行普通保存", gate.beginWrite() is WriteGate.Admission.Refused)
+
+        val recovered = kernel.recover()
+        assertTrue("清理补齐后应收敛，实际=$recovered", recovered is RecoverOutcome.Settled)
+        assertTrue("收敛到 Idle 后必须放行", gate.beginWrite() is WriteGate.Admission.Granted)
+    }
+
+    @Test
+    fun cleanupRefusedByStateStillKeepsWritesBlocked() = runBlocking {
+        sandbox.plant(spec(), notesState = NotesState.NEW)
+        val gate = WriteGate()
+        val kernel = sandbox.kernel(gate = gate)
+
+        val outcome = kernel.cleanup("t1")
+        assertFalse("中断态不得清理", outcome.cleaned)
+        assertTrue("中断态清理失败后仍须停写", gate.beginWrite() is WriteGate.Admission.Refused)
+    }
+
+    // ---------------- 互斥 ----------------
+
+    @Test
+    fun recoverWaitsForInFlightSave() = runBlocking {
+        sandbox.writeNotes(oldNotes)
+        val gate = WriteGate()
+        val kernel = sandbox.kernel(gate = gate)
+        val ticket = (gate.beginWrite() as WriteGate.Admission.Granted).ticket
+
+        val saveStarted = CountDownLatch(1)
+        val releaseSave = CountDownLatch(1)
+        val save = launch(Dispatchers.IO) {
+            gate.write(ticket) {
+                saveStarted.countDown()
+                releaseSave.await(10, TimeUnit.SECONDS)
+            }
+        }
+        assertTrue("保存未开始", saveStarted.await(10, TimeUnit.SECONDS))
+
+        val recover = launch(Dispatchers.IO) { kernel.recover() }
+        val finishedWhileSaving = withTimeoutOrNull(1_000) {
+            recover.join()
+            true
+        } ?: false
+        assertFalse("恢复必须等普通写释放写锁", finishedWhileSaving)
+
+        releaseSave.countDown()
+        save.join()
+        recover.join()
+        assertNotNull("恢复最终必须收敛", kernel.inspect())
+    }
+
+    // ---------------- 票据 ----------------
+
+    @Test
+    fun foreignTicketIsRefused() = runBlocking {
+        val one = WriteGate()
+        val other = WriteGate()
+        val ticket = (one.beginWrite() as WriteGate.Admission.Granted).ticket
+
+        val run = other.write(ticket) { 1 }
+        assertTrue("别的闸门发的票不得被接受，实际=$run", run is WriteGate.WriteRun.Refused)
+        assertFalse(
+            "跨闸门拒绝不是「写正忙」",
+            (run as WriteGate.WriteRun.Refused).refusal == WriteGate.Refusal.Busy
+        )
+    }
+
+    @Test
+    fun replayIsRefusedAsStaleNotBusy() = runBlocking {
+        val gate = WriteGate()
+        val ticket = (gate.beginWrite() as WriteGate.Admission.Granted).ticket
+        assertTrue(gate.write(ticket) { 1 } is WriteGate.WriteRun.Completed)
+
+        val replay = gate.write(ticket) { 2 }
+        assertTrue("同一张票不能重放，实际=$replay", replay is WriteGate.WriteRun.Refused)
+        val refusal = (replay as WriteGate.WriteRun.Refused).refusal
+        assertFalse("重放拒绝不是「写正忙」", refusal == WriteGate.Refusal.Busy)
+        assertFalse("重放拒绝不是「不在 OPEN」", refusal == WriteGate.Refusal.NotOpen)
+        assertEquals(WriteGate.Freshness.Stale, gate.freshness(ticket))
+    }
+}
