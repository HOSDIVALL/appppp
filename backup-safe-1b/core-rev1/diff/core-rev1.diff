+/**
+ * 与内核写出的 `old-manifest.json` 同形：
+ * `{"version":1,"notes":{"present":…,"digest":…},"attachments":[{"name":…,"old":…}]}`。
+ *
+ * 这里手写而不复用生产编码器，是因为这批回归测试要先在**未修实现**的 core-rev0 上跑红一次，
+ * 那时内核还没有 manifest 的编解码。
+ */
+internal fun manifestJson(oldNotesDigest: String?, attachments: List<JournalAttachment>): String {
+    val array = JSONArray()
+    attachments.forEach { entry ->
+        array.put(JSONObject().put("name", entry.name).put("old", entry.old ?: JSONObject.NULL))
+    }
+    val notes = JSONObject().put("present", oldNotesDigest != null)
+    if (oldNotesDigest != null) notes.put("digest", oldNotesDigest)
+    return JSONObject()
+        .put("version", 1)
+        .put("notes", notes)
+        .put("attachments", array)
+        .toString()
+}
